<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact · LinksMaxing</title>
<meta name="description" content="Request your scan. One inbox. One person. Same business day response. AI answers, search performance, site structure. Cross-referenced.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&family=Saira+Condensed:wght@500;700;900&display=swap" rel="stylesheet">
<style>
/* ==== TOKENS ==== */
:root {
  --bone: #F4F1EA;
  --ink:  #151412;
  --ox:   #6E0E0E;
  --ox-hover: #8B1616;
  --ink-dim:    rgba(21, 20, 18, 0.72);
  --ink-dimmer: rgba(21, 20, 18, 0.5);
  --ink-rule:   rgba(21, 20, 18, 0.22);
  --ink-soft:   rgba(21, 20, 18, 0.14);
  --bone-dim:    rgba(244, 241, 234, 0.72);
  --bone-dimmer: rgba(244, 241, 234, 0.5);
  --bone-rule:   rgba(244, 241, 234, 0.22);
  --bone-soft:   rgba(244, 241, 234, 0.14);
  --font-d: 'Saira Condensed', Impact, sans-serif;
  --font-b: 'Inter', system-ui, sans-serif;
  --font-m: 'JetBrains Mono', ui-monospace, monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body {
  background: var(--bone);
  color: var(--ink);
  font-family: var(--font-b);
  font-size: 16px;
  line-height: 1.5;
  overflow-x: hidden;
}
a { color: inherit; text-decoration: none; }
::selection { background: var(--ox); color: var(--bone); }
.container { max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 64px); }

/* ==== TOP NAV ==== */
.nav-top {
  display: flex; justify-content: space-between; align-items: baseline;
  padding: 20px 0 16px; border-bottom: 0.5px solid var(--ink-soft); gap: 24px;
}

/* Main nav logo mark */
.nav-mark {
  display: block;
  width: 22px;
  height: 22px;
  color: var(--ink);
  flex-shrink: 0;
  align-self: center;
}

.nav-brand { display: inline-flex; align-items: baseline; gap: 10px; }
.nav-brand .logo { font-weight: 500; font-size: 15px; letter-spacing: -0.005em; line-height: 1; }
.nav-brand .logo-sub {
  font-family: var(--font-m);
  font-size: 9px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
  line-height: 1;
}
.nav-links { display: flex; gap: clamp(18px, 2.2vw, 28px); align-items: baseline; }
.nav-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-dim);
}
.nav-links a:hover { color: var(--ink); }
.nav-links a.active { color: var(--ox); }
.nav-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
  white-space: nowrap;
}

/* ==== STICKY NAV ==== */
.nav-sticky {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(244, 241, 234, 0.94);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border-bottom: 0.5px solid var(--ink-rule);
  transform: translateY(-105%);
  transition: transform 380ms cubic-bezier(0.2, 0.7, 0.2, 1);
  pointer-events: none;
}
.nav-sticky.visible { transform: translateY(0); pointer-events: auto; }
.nav-sticky-inner {
  max-width: 1280px; margin: 0 auto;
  padding: 12px clamp(20px, 4vw, 64px);
  display: flex; justify-content: space-between; align-items: center; gap: 24px;
}
.nav-sticky-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; font-size: 14px; color: var(--ink); white-space: nowrap; }
.nav-sticky-mark { display: block; width: 26px; height: 26px; color: var(--ink); }
.nav-sticky-links { display: flex; gap: clamp(16px, 2vw, 26px); }
.nav-sticky-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-dim);
}
.nav-sticky-links a.active { color: var(--ox); }
.nav-sticky-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
}

/* ==== PAGE HEADER ==== */
.page-head {
  padding: clamp(40px, 6vh, 72px) 0 clamp(56px, 9vh, 96px);
  border-bottom: 0.5px solid var(--ink-rule);
}
.page-label {
  display: inline-block;
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 22px;
}
.page-title {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(56px, 11vw, 180px);
  line-height: 0.86;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  margin-bottom: 28px;
  text-wrap: balance;
}
.page-title .ox { color: var(--ox); }
.page-dek {
  font-size: clamp(17px, 1.4vw, 21px);
  line-height: 1.55;
  color: var(--ink-dim);
  max-width: 740px;
}

/* ==== PRIMARY SCAN REQUEST BLOCK ==== */
.scan-block {
  padding: clamp(64px, 10vh, 120px) 0 clamp(48px, 7vh, 88px);
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: clamp(40px, 6vw, 96px);
  align-items: start;
}
.scan-block-copy {}
.scan-block-marker {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 20px;
}
.scan-block-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(38px, 5.5vw, 78px);
  line-height: 0.96;
  letter-spacing: -0.025em;
  text-transform: uppercase;
  margin-bottom: 28px;
  text-wrap: balance;
}
.scan-block-h .ox { color: var(--ox); }
.scan-block-body {
  font-size: 16.5px;
  line-height: 1.65;
  color: var(--ink-dim);
  max-width: 560px;
  margin-bottom: 32px;
}
.scan-block-body p + p { margin-top: 16px; }
.scan-block-body em { color: var(--ox); font-style: normal; font-weight: 500; }

.scan-block-cta {
  display: inline-block;
  background: var(--ox);
  color: var(--bone);
  font-family: var(--font-m);
  font-weight: 500;
  font-size: 13px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 22px 40px;
  transition: background 0.2s;
}
.scan-block-cta:hover { background: var(--ox-hover); }
.scan-block-alt {
  margin-top: 22px;
  font-size: 14px;
  color: var(--ink-dim);
}
.scan-block-alt a { color: var(--ink); border-bottom: 1px solid var(--ink-rule); padding-bottom: 1px; }

/* Right column — what to include */
.request-box {
  padding: 32px;
  border: 1px solid var(--ink);
  background: rgba(21,20,18,0.02);
}
.request-box-label {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 14px;
}
.request-box-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: 24px;
  line-height: 1.1;
  letter-spacing: -0.015em;
  margin-bottom: 22px;
}
.request-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.request-list li {
  padding: 14px 0;
  border-top: 0.5px solid var(--ink-soft);
  display: grid;
  grid-template-columns: 22px 1fr;
  gap: 12px;
  align-items: baseline;
}
.request-list li:first-child { border-top: none; padding-top: 0; }
.request-list li:last-child { padding-bottom: 0; }
.request-list-num {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: var(--ox);
}
.request-list-body {
  font-size: 14px;
  line-height: 1.5;
  color: var(--ink);
}
.request-list-body em { color: var(--ox); font-style: normal; font-weight: 500; }

/* ==== TIMELINE — what happens next ==== */
.content-section {
  padding: clamp(56px, 8vh, 96px) 0;
  border-top: 0.5px solid var(--ink-soft);
}
.section-marker {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 22px;
}
.content-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(34px, 5vw, 68px);
  line-height: 0.96;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  margin-bottom: 44px;
  max-width: 900px;
  text-wrap: balance;
}
.content-h .ox { color: var(--ox); }

.steps-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
}
.step-cell {
  padding: 30px clamp(14px, 2vw, 26px) 30px 0;
  border-right: 0.5px solid var(--ink-soft);
}
.step-cell:last-child { border-right: none; padding-right: 0; }
.step-cell:not(:first-child) { padding-left: clamp(14px, 2vw, 26px); }
.step-num {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 16px;
}
.step-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: 22px;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 12px;
}
.step-body {
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink-dim);
  margin-bottom: 16px;
}
.step-when {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ox);
  padding-top: 12px;
  border-top: 0.5px solid var(--ink-soft);
  display: block;
}

/* ==== OTHER CHANNELS ==== */
.channels-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  margin-top: 32px;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
}
.channel {
  padding: 26px clamp(14px, 2vw, 26px) 26px 0;
  border-right: 0.5px solid var(--ink-soft);
  border-bottom: 0.5px solid var(--ink-soft);
}
.channel:nth-child(even) { border-right: none; padding-right: 0; padding-left: clamp(14px, 2vw, 26px); }
.channel:nth-last-child(-n+2) { border-bottom: none; }
.channel-label {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 12px;
}
.channel-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: 22px;
  line-height: 1.1;
  letter-spacing: -0.015em;
  margin-bottom: 10px;
}
.channel-h a {
  border-bottom: 2px solid var(--ink);
  padding-bottom: 2px;
}
.channel-h a:hover { color: var(--ox); border-bottom-color: var(--ox); }
.channel-body {
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink-dim);
}

/* ==== WHAT WE WON'T DO ==== */
.refuse-list {
  margin: 32px 0 0;
  padding: 0;
  list-style: none;
}
.refuse-list li {
  padding: 18px 0;
  border-top: 0.5px solid var(--ink-soft);
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: 14px;
  align-items: baseline;
}
.refuse-list li:first-child { border-top: 1px solid var(--ink); }
.refuse-list li:last-child { border-bottom: 1px solid var(--ink); }
.refuse-mark {
  font-family: var(--font-m);
  font-size: 14px;
  font-weight: 700;
  color: var(--ox);
  line-height: 1;
  padding-top: 2px;
}
.refuse-body {
  font-size: 15.5px;
  line-height: 1.55;
  color: var(--ink);
}
.refuse-body em { color: var(--ox); font-style: normal; font-weight: 500; }

/* ==== PRICING NOTE — commitment, not refusal ==== */
.pricing-note {
  margin-top: 44px;
  padding-top: 32px;
  border-top: 3px solid var(--ink);
}
.pricing-note-label {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 16px;
}
.pricing-note-body {
  font-family: var(--font-b);
  font-size: 17.5px;
  line-height: 1.6;
  color: var(--ink);
  max-width: 820px;
}
.pricing-note-body em {
  color: var(--ox);
  font-style: normal;
  font-weight: 500;
}

/* ==== DETAILS ==== */
.details-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(20px, 3vw, 40px);
  margin-top: 40px;
  padding: 28px 0;
  border-top: 3px solid var(--ink);
  border-bottom: 3px solid var(--ink);
}
.details-cell { display: flex; flex-direction: column; gap: 8px; }
.details-label {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
}
.details-value {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(20px, 2.2vw, 28px);
  line-height: 1;
  letter-spacing: -0.015em;
  color: var(--ink);
}
.details-value.small {
  font-family: var(--font-b);
  font-weight: 500;
  font-size: 15px;
  letter-spacing: 0;
  line-height: 1.35;
}

/* ==== FOOTER ==== */
.footer {
  padding: clamp(60px, 8vh, 100px) 0 clamp(36px, 5vh, 60px);
  background: var(--ink);
  color: var(--bone);
  margin-top: clamp(72px, 10vh, 120px);
}
.footer-mark { width: 32px; height: 32px; color: var(--bone); margin-bottom: 18px; }
.footer-signature {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: clamp(48px, 6vh, 72px);
  padding-bottom: 28px;
  border-bottom: 0.5px solid var(--bone-rule);
}
.footer-cols {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: clamp(28px, 4vw, 64px);
  margin-bottom: 40px;
}
.footer-col-head {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: 14px;
}
.footer-col a, .footer-col span, .footer-col p {
  display: block;
  font-size: 13.5px;
  line-height: 1.75;
  color: var(--bone-dim);
}
.footer-col a:hover { color: var(--bone); }
.footer-col-colophon p { font-size: 12.5px; line-height: 1.75; color: var(--bone-dimmer); max-width: 380px; }
.footer-col-colophon p em { color: var(--ox); font-style: normal; }
.footer-copy {
  padding-top: 22px;
  border-top: 0.5px solid var(--bone-soft);
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dimmer);
}

/* ==== MOBILE ==== */
@media (max-width: 900px) {
  .scan-block { grid-template-columns: 1fr; gap: 40px; }
  .steps-grid { grid-template-columns: repeat(2, 1fr); }
  .step-cell {
    border-right: 0.5px solid var(--ink-soft);
    border-bottom: 0.5px solid var(--ink-soft);
  }
  .step-cell:nth-child(even) { border-right: none; padding-right: 0; padding-left: clamp(14px, 2vw, 26px); }
  .step-cell:nth-last-child(-n+2) { border-bottom: none; }
  .channels-grid { grid-template-columns: 1fr; }
  .channel { border-right: none; padding-right: 0; padding-left: 0; border-bottom: 0.5px solid var(--ink-soft); }
  .channel:nth-child(even) { padding-left: 0; }
  .channel:nth-last-child(-n+2) { border-bottom: 0.5px solid var(--ink-soft); }
  .channel:last-child { border-bottom: none; }
  .details-grid { grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .footer-cols { grid-template-columns: 1fr 1fr; }
  .footer-col-colophon { grid-column: 1 / -1; }
}

@media (max-width: 720px) {
  html, body { -webkit-text-size-adjust: 100%; }
  .container { padding: 0 20px; }

  .nav-top { padding: 14px 0 12px; align-items: center; gap: 14px; }
  .nav-top .nav-links { display: none; }
  .nav-brand .logo { font-size: 14px; }
  .nav-brand .logo-sub { font-size: 8.5px; letter-spacing: 0.22em; }
  .nav-cta { font-size: 10px; letter-spacing: 0.14em; }
  .nav-sticky-inner { padding: 10px 20px; gap: 14px; }
  .nav-sticky-brand { font-size: 13px; gap: 8px; }
  .nav-sticky-mark { width: 22px; height: 22px; }
  .nav-sticky-links { display: none; }
  .nav-sticky-cta { font-size: 10px; letter-spacing: 0.14em; }

  .page-head { padding: 32px 0 40px; }
  .page-label { font-size: 10px; margin-bottom: 18px; }
  .page-title { font-size: clamp(48px, 15vw, 96px); margin-bottom: 22px; }
  .page-dek { font-size: 15.5px; }

  .scan-block { padding: 44px 0 32px; gap: 32px; }
  .scan-block-marker { font-size: 10px; margin-bottom: 14px; }
  .scan-block-h { font-size: clamp(30px, 9vw, 52px); margin-bottom: 22px; }
  .scan-block-body { font-size: 15.5px; margin-bottom: 24px; }
  .scan-block-cta { padding: 18px 30px; font-size: 12px; letter-spacing: 0.16em; }

  .request-box { padding: 22px; }
  .request-box-h { font-size: 20px; margin-bottom: 18px; }
  .request-list li { padding: 12px 0; }
  .request-list-body { font-size: 13.5px; }

  .content-section { padding: 44px 0; }
  .section-marker { font-size: 10px; margin-bottom: 16px; }
  .content-h { font-size: clamp(28px, 8vw, 50px); margin-bottom: 30px; }

  .step-num { font-size: 9.5px; margin-bottom: 12px; }
  .step-h { font-size: 19px; margin-bottom: 10px; }
  .step-body { font-size: 13.5px; }
  .step-when { font-size: 9.5px; padding-top: 10px; }
  .step-cell { padding: 22px clamp(12px, 2vw, 20px) 22px 0; }
  .step-cell:not(:first-child) { padding-left: clamp(12px, 2vw, 20px); }

  .channel { padding: 22px 0; }
  .channel-label { font-size: 9.5px; margin-bottom: 10px; }
  .channel-h { font-size: 19px; margin-bottom: 8px; }
  .channel-body { font-size: 13.5px; }

  .refuse-list li { grid-template-columns: 22px 1fr; gap: 12px; padding: 16px 0; }
  .refuse-mark { font-size: 13px; }
  .refuse-body { font-size: 14.5px; }

  .pricing-note { margin-top: 32px; padding-top: 24px; }
  .pricing-note-label { font-size: 10px; letter-spacing: 0.2em; margin-bottom: 12px; }
  .pricing-note-body { font-size: 15.5px; line-height: 1.6; }

  .details-grid { gap: 20px 16px; padding: 22px 0; margin-top: 32px; }
  .details-label { font-size: 9px; letter-spacing: 0.18em; }
  .details-value { font-size: clamp(18px, 4.5vw, 24px); }
  .details-value.small { font-size: 14px; }

  .footer { padding: 52px 0 40px; margin-top: 56px; }
  .footer-signature { font-size: 10px; margin-bottom: 40px; padding-bottom: 22px; }
  .footer-cols { grid-template-columns: 1fr 1fr; gap: 28px; }
  .footer-col-colophon { grid-column: 1 / -1; }
  .footer-col-head { font-size: 9.5px; margin-bottom: 10px; }
  .footer-col a, .footer-col span { font-size: 12.5px; }
  .footer-copy { font-size: 9.5px; padding-top: 18px; }
}

@media (max-width: 480px) {
  .container { padding: 0 16px; }
  .page-title { font-size: clamp(42px, 16vw, 80px); }
  .steps-grid { grid-template-columns: 1fr; }
  .step-cell { border-right: none; padding-right: 0; padding-left: 0; }
  .step-cell:nth-child(even) { padding-left: 0; }
  .details-grid { grid-template-columns: 1fr 1fr; }
  .footer-cols { grid-template-columns: 1fr; gap: 24px; }
}
