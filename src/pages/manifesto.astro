<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The LinksMaxing Manifesto · Dallas · 2026</title>
<meta name="description" content="Real decisions come from real data. Real work produces real outcomes. The revolution starts now. The LinksMaxing Manifesto, filed in Dallas, 2026.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&family=Saira+Condensed:wght@500;700;900&display=swap" rel="stylesheet">
<style>
/* ==== TOKENS ==== */
:root {
  --bone: #F4F1EA;
  --ink:  #151412;
  --ox:   #6E0E0E;
  --ox-hover: #8B1616;
  --ink-dim:    rgba(21, 20, 18, 0.72);
  --ink-dimmer: rgba(21, 20, 18, 0.5);
  --ink-rule:   rgba(21, 20, 18, 0.22);
  --ink-soft:   rgba(21, 20, 18, 0.14);
  --bone-dim:    rgba(244, 241, 234, 0.72);
  --bone-dimmer: rgba(244, 241, 234, 0.5);
  --bone-rule:   rgba(244, 241, 234, 0.22);
  --bone-soft:   rgba(244, 241, 234, 0.14);
  --font-d: 'Saira Condensed', Impact, sans-serif;
  --font-b: 'Inter', system-ui, sans-serif;
  --font-m: 'JetBrains Mono', ui-monospace, monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body {
  background: var(--bone);
  color: var(--ink);
  font-family: var(--font-b);
  font-size: 16px;
  line-height: 1.5;
  overflow-x: hidden;
}
a { color: inherit; text-decoration: none; }
::selection { background: var(--ox); color: var(--bone); }

.container { max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 64px); }
.section-dark { background: var(--ink); color: var(--bone); }
.section-ox { background: var(--ox); color: var(--bone); }

/* ==== TOP NAV ==== */
.nav-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20px 0 16px;
  border-bottom: 0.5px solid var(--ink-soft);
  gap: 24px;
}
.nav-brand { display: inline-flex; align-items: baseline; gap: 10px; }
.nav-brand .logo { font-weight: 500; font-size: 15px; letter-spacing: -0.005em; line-height: 1; }
.nav-brand .logo-sub {
  font-family: var(--font-m);
  font-size: 9px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
  line-height: 1;
}
.nav-links { display: flex; gap: clamp(18px, 2.2vw, 28px); align-items: baseline; }
.nav-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-dim);
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--ink); }
.nav-links a.active { color: var(--ox); }
.nav-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
  white-space: nowrap;
}

/* ==== STICKY NAV ==== */
.nav-sticky {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(244, 241, 234, 0.94);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border-bottom: 0.5px solid var(--ink-rule);
  transform: translateY(-105%);
  transition: transform 380ms cubic-bezier(0.2, 0.7, 0.2, 1);
  pointer-events: none;
}
.nav-sticky.visible { transform: translateY(0); pointer-events: auto; }
.nav-sticky-inner {
  max-width: 1280px; margin: 0 auto;
  padding: 12px clamp(20px, 4vw, 64px);
  display: flex; justify-content: space-between; align-items: center; gap: 24px;
}
.nav-sticky-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; font-size: 14px; color: var(--ink); white-space: nowrap; }
.nav-sticky-mark { display: block; width: 26px; height: 26px; color: var(--ink); }
.nav-sticky-links { display: flex; gap: clamp(16px, 2vw, 26px); }
.nav-sticky-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-dim);
}
.nav-sticky-links a.active { color: var(--ox); }
.nav-sticky-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
}

/* ==== PAGE HEADER — masthead treatment ==== */
.doc-head {
  padding: clamp(40px, 6vh, 72px) 0 clamp(56px, 9vh, 96px);
  border-bottom: 3px solid var(--ink);
}
.doc-masthead-rail {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20px;
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-dim);
  padding-bottom: 14px;
  border-bottom: 0.5px solid var(--ink-rule);
  margin-bottom: 22px;
}
.doc-masthead-rail .ox { color: var(--ox); }
.doc-title {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(60px, 11vw, 200px);
  line-height: 0.85;
  letter-spacing: -0.04em;
  text-transform: uppercase;
  color: var(--ink);
  margin: 8px 0 22px;
}
.doc-dek {
  font-family: var(--font-b);
  font-size: clamp(17px, 1.4vw, 22px);
  line-height: 1.55;
  color: var(--ink-dim);
  max-width: 780px;
}

/* ==== PREAMBLE ==== */
.preamble {
  padding: clamp(60px, 9vh, 100px) 0 clamp(40px, 6vh, 72px);
  border-bottom: 0.5px solid var(--ink-rule);
}
.preamble-label {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 22px;
}
.preamble-body {
  font-size: 17px;
  line-height: 1.7;
  color: var(--ink-dim);
  max-width: 860px;
}
.preamble-body p + p { margin-top: 20px; }
.preamble-body em { color: var(--ox); font-style: normal; font-weight: 500; }

/* ==== MANIFESTO BODY — the document itself ==== */
.doc-body {
  padding: clamp(72px, 12vh, 140px) 0;
}
.doc-body-label {
  font-family: var(--font-m);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: clamp(36px, 5vh, 56px);
  padding-bottom: 18px;
  border-bottom: 1px solid var(--ink);
}
.doc-body-copy {
  font-family: var(--font-d);
  font-weight: 700;
  font-size: clamp(26px, 2.8vw, 46px);
  line-height: 1.14;
  letter-spacing: -0.005em;
  color: var(--ink);
  max-width: 1080px;
  text-wrap: pretty;
}
.doc-body-copy p + p { margin-top: clamp(28px, 4vh, 48px); }
.doc-body-copy .real { font-weight: 900; color: var(--ox); }

/* ==== PRINCIPLES ==== */
.principles {
  padding: clamp(72px, 12vh, 140px) 0;
  border-top: 3px solid var(--ink);
}
.principles-label {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 26px;
}
.principles-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(44px, 7vw, 110px);
  line-height: 0.92;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  margin-bottom: clamp(48px, 7vh, 80px);
  max-width: 900px;
}
.principles-h .ox { color: var(--ox); }
.principles-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0;
}
.principles-list li {
  display: grid;
  grid-template-columns: 60px 1fr;
  gap: clamp(20px, 3vw, 40px);
  padding: 30px 0;
  border-top: 0.5px solid var(--ink-soft);
  align-items: baseline;
}
.principles-list li:first-child { border-top: 1px solid var(--ink); }
.principles-list li:last-child { border-bottom: 1px solid var(--ink); }
.principle-num {
  font-family: var(--font-m);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.22em;
  color: var(--ox);
  padding-top: 4px;
}
.principle-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(22px, 2.6vw, 34px);
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 12px;
}
.principle-body {
  font-size: 15.5px;
  line-height: 1.6;
  color: var(--ink-dim);
  max-width: 700px;
}

/* ==== THE DECLARATION — oxblood ground ==== */
.declaration {
  padding: clamp(120px, 20vh, 220px) 0;
}
.declaration-label {
  font-family: var(--font-m);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: clamp(44px, 6vh, 72px);
  padding-bottom: 18px;
  border-bottom: 1px solid var(--bone-rule);
}
.declaration-close {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(64px, 12vw, 220px);
  line-height: 0.88;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  color: var(--ink);
  text-wrap: balance;
  margin-bottom: clamp(48px, 7vh, 88px);
}

/* ==== SIGNATURE ==== */
.signature {
  padding-top: clamp(32px, 4vh, 48px);
  border-top: 0.5px solid var(--bone-rule);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24px;
  flex-wrap: wrap;
}
.signature-block { display: flex; flex-direction: column; gap: 4px; }
.signature-label {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dim);
}
.signature-value {
  font-family: var(--font-b);
  font-weight: 500;
  font-size: 14px;
  color: var(--bone);
}
.signature-value.doc-name {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: 22px;
  letter-spacing: -0.01em;
  text-transform: uppercase;
}

/* ==== PAGE CLOSE ==== */
.page-close {
  padding: clamp(80px, 12vh, 140px) 0 clamp(48px, 8vh, 96px);
  border-top: 3px solid var(--ink);
}
.close-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(44px, 8vw, 110px);
  line-height: 0.92;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  margin-bottom: 28px;
  text-wrap: balance;
}
.close-h .ox { color: var(--ox); }
.close-body {
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink-dim);
  max-width: 640px;
  margin-bottom: 36px;
}
.cta-button {
  display: inline-block;
  background: var(--ox);
  color: var(--bone);
  font-family: var(--font-m);
  font-weight: 500;
  font-size: 13px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 20px 36px;
  transition: background 0.2s;
}
.cta-button:hover { background: var(--ox-hover); }
.close-alt { margin-top: 26px; font-size: 14px; color: var(--ink-dim); }
.close-alt a { color: var(--ink); border-bottom: 1px solid var(--ink-rule); padding-bottom: 1px; }

/* ==== FOOTER ==== */
.footer {
  padding: clamp(60px, 8vh, 100px) 0 clamp(36px, 5vh, 60px);
  background: var(--ink);
  color: var(--bone);
}
.footer-mark { width: 32px; height: 32px; color: var(--bone); margin-bottom: 18px; }
.footer-signature {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: clamp(48px, 6vh, 72px);
  padding-bottom: 28px;
  border-bottom: 0.5px solid var(--bone-rule);
}
.footer-cols {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: clamp(28px, 4vw, 64px);
  margin-bottom: 40px;
}
.footer-col-head {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: 14px;
}
.footer-col a, .footer-col span, .footer-col p {
  display: block;
  font-size: 13.5px;
  line-height: 1.75;
  color: var(--bone-dim);
}
.footer-col a:hover { color: var(--bone); }
.footer-col-colophon p { font-size: 12.5px; line-height: 1.75; color: var(--bone-dimmer); max-width: 380px; }
.footer-col-colophon p em { color: var(--ox); font-style: normal; }
.footer-copy {
  padding-top: 22px;
  border-top: 0.5px solid var(--bone-soft);
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dimmer);
}

/* ==== MOBILE ==== */
@media (max-width: 900px) {
  .footer-cols { grid-template-columns: 1fr 1fr; }
  .footer-col-colophon { grid-column: 1 / -1; }
}

@media (max-width: 720px) {
  html, body { -webkit-text-size-adjust: 100%; }
  .container { padding: 0 20px; }

  .nav-top { padding: 14px 0 12px; align-items: center; gap: 14px; }
  .nav-top .nav-links { display: none; }
  .nav-brand .logo { font-size: 14px; }
  .nav-brand .logo-sub { font-size: 8.5px; letter-spacing: 0.22em; }
  .nav-cta { font-size: 10px; letter-spacing: 0.14em; }
  .nav-sticky-inner { padding: 10px 20px; gap: 14px; }
  .nav-sticky-brand { font-size: 13px; gap: 8px; }
  .nav-sticky-mark { width: 22px; height: 22px; }
  .nav-sticky-links { display: none; }
  .nav-sticky-cta { font-size: 10px; letter-spacing: 0.14em; }

  .doc-head { padding: 32px 0 44px; }
  .doc-masthead-rail {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-size: 9.5px;
    letter-spacing: 0.2em;
  }
  .doc-title { font-size: clamp(52px, 15vw, 108px); margin: 4px 0 18px; }
  .doc-dek { font-size: 15.5px; }

  .preamble { padding: 44px 0 32px; }
  .preamble-label { font-size: 10.5px; margin-bottom: 18px; }
  .preamble-body { font-size: 15.5px; line-height: 1.65; }

  .doc-body { padding: 52px 0; }
  .doc-body-label { font-size: 11px; letter-spacing: 0.24em; margin-bottom: 32px; padding-bottom: 14px; }
  .doc-body-copy { font-size: clamp(22px, 6.2vw, 34px); line-height: 1.18; }
  .doc-body-copy p + p { margin-top: 24px; }

  .principles { padding: 52px 0; }
  .principles-h { font-size: clamp(38px, 11vw, 76px); margin-bottom: 40px; }
  .principles-list li { grid-template-columns: 42px 1fr; gap: 14px; padding: 22px 0; }
  .principle-num { font-size: 11px; }
  .principle-h { font-size: 19px; margin-bottom: 10px; }
  .principle-body { font-size: 14.5px; line-height: 1.55; }

  .declaration { padding: 80px 0 88px; }
  .declaration-label { font-size: 10.5px; margin-bottom: 30px; padding-bottom: 14px; }
  .declaration-close { font-size: clamp(46px, 13vw, 96px); margin-bottom: 40px; }
  .signature {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-top: 24px;
  }
  .signature-label { font-size: 9.5px; }
  .signature-value.doc-name { font-size: 18px; }

  .page-close { padding: 56px 0 40px; }
  .close-h { font-size: clamp(36px, 11vw, 72px); margin-bottom: 22px; }
  .close-body { font-size: 15.5px; margin-bottom: 28px; }
  .cta-button { padding: 16px 28px; font-size: 12px; letter-spacing: 0.16em; }

  .footer { padding: 52px 0 40px; }
  .footer-signature { font-size: 10px; margin-bottom: 40px; padding-bottom: 22px; }
  .footer-cols { grid-template-columns: 1fr 1fr; gap: 28px; }
  .footer-col-colophon { grid-column: 1 / -1; }
  .footer-col-head { font-size: 9.5px; margin-bottom: 10px; }
  .footer-col a, .footer-col span { font-size: 12.5px; }
  .footer-copy { font-size: 9.5px; padding-top: 18px; }
}

@media (max-width: 480px) {
  .container { padding: 0 16px; }
  .doc-title { font-size: clamp(44px, 16vw, 88px); }
  .doc-body-copy { font-size: clamp(20px, 6.5vw, 30px); }
  .declaration-close { font-size: clamp(40px, 14vw, 78px); }
  .footer-cols { grid-template-columns: 1fr; gap: 24px; }
}
a, button, [role="button"], .cta, .cta-primary, .cta-ghost, .nav-link, [href], [onclick] { cursor: pointer; }
