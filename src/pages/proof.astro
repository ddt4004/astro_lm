<script is:inline>
(function(){
  var stickyNav = document.querySelector('.nav-sticky');
  var trigger = document.querySelector('.page-head');
  if (!stickyNav || !trigger || !('IntersectionObserver' in window)) return;
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      var show = !e.isIntersecting;
      stickyNav.classList.toggle('visible', show);
      stickyNav.setAttribute('aria-hidden', show ? 'false' : 'true');
    });
  }, { rootMargin: '-40px 0px 0px 0px', threshold: 0 });
  obs.observe(trigger);
})();
