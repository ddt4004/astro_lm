<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Method · v2.4.1 · LinksMaxing</title>
<meta name="description" content="LinksMaxing methodology. Three sources cross-referenced. Correlation is the differentiator. Documented, versioned, and running against every engagement.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&family=Saira+Condensed:wght@500;700;900&display=swap" rel="stylesheet">
<style>
:root {
  --bone: #F4F1EA;
  --ink:  #151412;
  --ox:   #6E0E0E;
  --ox-hover: #8B1616;
  --ink-dim:    rgba(21, 20, 18, 0.72);
  --ink-dimmer: rgba(21, 20, 18, 0.5);
  --ink-rule:   rgba(21, 20, 18, 0.22);
  --ink-soft:   rgba(21, 20, 18, 0.14);
  --bone-dim:    rgba(244, 241, 234, 0.72);
  --bone-dimmer: rgba(244, 241, 234, 0.5);
  --bone-rule:   rgba(244, 241, 234, 0.22);
  --bone-soft:   rgba(244, 241, 234, 0.14);
  --font-d: 'Saira Condensed', Impact, sans-serif;
  --font-b: 'Inter', system-ui, sans-serif;
  --font-m: 'JetBrains Mono', ui-monospace, monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body { background: var(--bone); color: var(--ink); font-family: var(--font-b); font-size: 16px; line-height: 1.5; overflow-x: hidden; }
a { color: inherit; text-decoration: none; }
::selection { background: var(--ox); color: var(--bone); }
.container { max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 64px); }

/* ==== NAV ==== */
.nav-top { display: flex; justify-content: space-between; align-items: baseline; padding: 20px 0 16px; border-bottom: 0.5px solid var(--ink-soft); gap: 24px; }

/* Main nav logo mark */
.nav-mark {
  display: block;
  width: 22px;
  height: 22px;
  color: var(--ink);
  flex-shrink: 0;
  align-self: center;
}

.nav-brand { display: inline-flex; align-items: baseline; gap: 10px; }
.nav-brand .logo { font-weight: 500; font-size: 15px; letter-spacing: -0.005em; line-height: 1; }
.nav-brand .logo-sub { font-family: var(--font-m); font-size: 9px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-dimmer); line-height: 1; }
.nav-links { display: flex; gap: clamp(18px, 2.2vw, 28px); align-items: baseline; }
.nav-links a { font-family: var(--font-m); font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-dim); }
.nav-links a:hover { color: var(--ink); }
.nav-links a.active { color: var(--ox); }
.nav-cta { font-family: var(--font-m); font-size: 10.5px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ox); border-bottom: 1px solid var(--ox); padding-bottom: 3px; white-space: nowrap; }

.nav-sticky { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(244, 241, 234, 0.94); backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%); border-bottom: 0.5px solid var(--ink-rule); transform: translateY(-105%); transition: transform 380ms cubic-bezier(0.2, 0.7, 0.2, 1); pointer-events: none; }
.nav-sticky.visible { transform: translateY(0); pointer-events: auto; }
.nav-sticky-inner { max-width: 1280px; margin: 0 auto; padding: 12px clamp(20px, 4vw, 64px); display: flex; justify-content: space-between; align-items: center; gap: 24px; }
.nav-sticky-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; font-size: 14px; color: var(--ink); white-space: nowrap; }
.nav-sticky-mark { display: block; width: 26px; height: 26px; color: var(--ink); }
.nav-sticky-links { display: flex; gap: clamp(16px, 2vw, 26px); }
.nav-sticky-links a { font-family: var(--font-m); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-dim); }
.nav-sticky-links a.active { color: var(--ox); }
.nav-sticky-cta { font-family: var(--font-m); font-size: 10.5px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ox); border-bottom: 1px solid var(--ox); padding-bottom: 3px; }

/* ==== PAGE HEADER ==== */
.page-head { padding: clamp(40px, 6vh, 72px) 0 clamp(56px, 9vh, 96px); border-bottom: 0.5px solid var(--ink-rule); }
.doc-rail {
  display: flex; justify-content: space-between; align-items: baseline; gap: 20px;
  font-family: var(--font-m); font-size: 10.5px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-dim);
  padding-bottom: 14px; border-bottom: 0.5px solid var(--ink-rule); margin-bottom: 22px;
}
.doc-rail .ox { color: var(--ox); }
.page-title { font-family: var(--font-d); font-weight: 900; font-size: clamp(56px, 11vw, 176px); line-height: 0.86; letter-spacing: -0.035em; text-transform: uppercase; margin: 8px 0 26px; text-wrap: balance; }
.page-title .ox { color: var(--ox); }
.page-dek { font-size: clamp(17px, 1.4vw, 21px); line-height: 1.55; color: var(--ink-dim); max-width: 780px; }
.page-dek em { color: var(--ox); font-style: normal; font-weight: 500; }

/* ==== CONTENT SECTIONS ==== */
.content-section { padding: clamp(56px, 8vh, 96px) 0; border-top: 0.5px solid var(--ink-soft); }
.content-section:first-of-type { border-top: none; padding-top: clamp(40px, 6vh, 64px); }
.section-marker { font-family: var(--font-m); font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ox); margin-bottom: 22px; }
.content-h { font-family: var(--font-d); font-weight: 900; font-size: clamp(34px, 5vw, 68px); line-height: 0.96; letter-spacing: -0.02em; text-transform: uppercase; margin-bottom: 32px; text-wrap: balance; }
.content-h .ox { color: var(--ox); }
.content-body { max-width: 820px; font-size: 17px; line-height: 1.65; color: var(--ink-dim); }
.content-body p + p { margin-top: 20px; }
.content-body strong { color: var(--ink); font-weight: 500; }
.content-body em { color: var(--ox); font-style: normal; font-weight: 500; }

/* ==== THREE-SOURCE DEEP-DIVE CARDS ==== */
.sources {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-top: 44px;
  border-top: 3px solid var(--ink);
  border-bottom: 3px solid var(--ink);
}
.source-cell {
  padding: 36px clamp(18px, 2vw, 28px) 36px 0;
  border-right: 0.5px solid var(--ink-soft);
}
.source-cell:last-child { border-right: none; padding-right: 0; }
.source-cell:not(:first-child) { padding-left: clamp(18px, 2vw, 28px); }
.source-num { font-family: var(--font-m); font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ox); margin-bottom: 16px; }
.source-h { font-family: var(--font-d); font-weight: 900; font-size: clamp(26px, 3vw, 40px); line-height: 1.02; letter-spacing: -0.02em; margin-bottom: 18px; }
.source-body { font-size: 14.5px; line-height: 1.65; color: var(--ink-dim); margin-bottom: 22px; }
.source-detail {
  padding-top: 18px;
  border-top: 0.5px solid var(--ink-soft);
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  line-height: 1.7;
}
.source-detail-label { color: var(--ink-dimmer); display: block; margin-bottom: 4px; font-size: 9.5px; letter-spacing: 0.18em; }

/* ==== NUMBERED LOOP LIST ==== */
.numbered-list { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 0; }
.numbered-list li {
  display: grid;
  grid-template-columns: 60px 1fr auto;
  gap: clamp(20px, 3vw, 40px);
  padding: 30px 0;
  border-top: 0.5px solid var(--ink-soft);
  align-items: baseline;
}
.numbered-list li:first-child { border-top: 1px solid var(--ink); }
.numbered-list li:last-child { border-bottom: 1px solid var(--ink); }
.num-item-num { font-family: var(--font-m); font-size: 12px; font-weight: 500; letter-spacing: 0.22em; color: var(--ox); padding-top: 4px; }
.num-item-h { font-family: var(--font-d); font-weight: 900; font-size: clamp(22px, 2.5vw, 32px); line-height: 1.05; letter-spacing: -0.015em; margin-bottom: 10px; }
.num-item-body { font-size: 15.5px; line-height: 1.6; color: var(--ink-dim); max-width: 640px; }
.num-item-when {
  font-family: var(--font-m); font-size: 10.5px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ox);
  padding-top: 6px;
  white-space: nowrap;
}

/* ==== DARK PULL-QUOTE ==== */
.dark-block { background: var(--ink); color: var(--bone); padding: clamp(48px, 7vh, 88px) clamp(24px, 4vw, 64px); margin: clamp(48px, 7vh, 88px) 0; }
.dark-block-label { font-family: var(--font-m); font-size: 10.5px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--bone-dim); margin-bottom: 24px; }
.dark-block-body { font-family: var(--font-d); font-weight: 700; font-size: clamp(28px, 3.6vw, 52px); line-height: 1.1; letter-spacing: -0.015em; color: var(--bone); max-width: 940px; }
.dark-block-body em { color: var(--ox); font-style: normal; font-weight: 900; }

/* ==== SPEC vs AUDIT COMPARE ==== */
.compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  margin-top: 40px;
  border-top: 3px solid var(--ink);
  border-bottom: 3px solid var(--ink);
}
.compare-col { padding: 32px clamp(18px, 2.5vw, 32px) 32px 0; border-right: 1px solid var(--ink); }
.compare-col:last-child { border-right: none; padding-right: 0; padding-left: clamp(18px, 2.5vw, 32px); }
.compare-label { font-family: var(--font-m); font-size: 10.5px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; margin-bottom: 12px; }
.compare-col.we .compare-label { color: var(--ox); }
.compare-col.them .compare-label { color: var(--ink-dimmer); }
.compare-h { font-family: var(--font-d); font-weight: 900; font-size: clamp(24px, 3vw, 40px); line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 22px; }
.compare-col.them .compare-h { color: var(--ink-dimmer); text-decoration: line-through; text-decoration-thickness: 2px; }
.compare-list { list-style: none; padding: 0; margin: 0; }
.compare-list li { padding: 12px 0; border-top: 0.5px solid var(--ink-soft); font-size: 14.5px; line-height: 1.55; }
.compare-list li:first-child { border-top: none; padding-top: 0; }
.compare-col.we li { color: var(--ink); }
.compare-col.them li { color: var(--ink-dimmer); }

/* ==== REFUSE LIST ==== */
.refuse-list { list-style: none; padding: 0; margin: 32px 0 0; }
.refuse-list li {
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: 14px;
  padding: 20px 0;
  border-top: 0.5px solid var(--ink-soft);
  align-items: baseline;
}
.refuse-list li:first-child { border-top: 1px solid var(--ink); }
.refuse-list li:last-child { border-bottom: 1px solid var(--ink); }
.refuse-mark { font-family: var(--font-m); font-size: 14px; font-weight: 700; color: var(--ox); line-height: 1; padding-top: 2px; }
.refuse-body { font-size: 15.5px; line-height: 1.55; color: var(--ink); }
.refuse-body em { color: var(--ox); font-style: normal; font-weight: 500; }

/* ==== VERSION NOTES ==== */
.version-notes { list-style: none; padding: 0; margin: 32px 0 0; }
.version-notes li {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: clamp(20px, 3vw, 40px);
  padding: 18px 0;
  border-top: 0.5px solid var(--ink-soft);
  align-items: baseline;
}
.version-notes li:first-child { border-top: 1px solid var(--ink); }
.version-notes li:last-child { border-bottom: 1px solid var(--ink); }
.version-num { font-family: var(--font-m); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; color: var(--ox); }
.version-body { font-size: 14.5px; line-height: 1.6; color: var(--ink); }
.version-body-date { display: block; font-family: var(--font-m); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-dimmer); margin-top: 4px; }

/* ==== CLOSE ==== */
.page-close { padding: clamp(80px, 12vh, 140px) 0 clamp(48px, 8vh, 96px); margin-top: clamp(56px, 8vh, 96px); border-top: 3px solid var(--ink); }
.close-h { font-family: var(--font-d); font-weight: 900; font-size: clamp(44px, 8vw, 110px); line-height: 0.92; letter-spacing: -0.03em; text-transform: uppercase; margin-bottom: 28px; text-wrap: balance; }
.close-h .ox { color: var(--ox); }
.close-body { font-size: 17px; line-height: 1.6; color: var(--ink-dim); max-width: 640px; margin-bottom: 36px; }
.cta-button { display: inline-block; background: var(--ox); color: var(--bone); font-family: var(--font-m); font-weight: 500; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; padding: 20px 36px; transition: background 0.2s; }
.cta-button:hover { background: var(--ox-hover); }
.close-alt { margin-top: 26px; font-size: 14px; color: var(--ink-dim); }
.close-alt a { color: var(--ink); border-bottom: 1px solid var(--ink-rule); padding-bottom: 1px; }

/* ==== FOOTER ==== */
.footer { padding: clamp(60px, 8vh, 100px) 0 clamp(36px, 5vh, 60px); background: var(--ink); color: var(--bone); }
.footer-mark { width: 32px; height: 32px; color: var(--bone); margin-bottom: 18px; }
.footer-signature { font-family: var(--font-m); font-size: 11px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--bone-dim); margin-bottom: clamp(48px, 6vh, 72px); padding-bottom: 28px; border-bottom: 0.5px solid var(--bone-rule); }
.footer-cols { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: clamp(28px, 4vw, 64px); margin-bottom: 40px; }
.footer-col-head { font-family: var(--font-m); font-size: 10px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--bone-dim); margin-bottom: 14px; }
.footer-col a, .footer-col span, .footer-col p { display: block; font-size: 13.5px; line-height: 1.75; color: var(--bone-dim); }
.footer-col a:hover { color: var(--bone); }
.footer-col-colophon p { font-size: 12.5px; line-height: 1.75; color: var(--bone-dimmer); max-width: 380px; }
.footer-col-colophon p em { color: var(--ox); font-style: normal; }
.footer-copy { padding-top: 22px; border-top: 0.5px solid var(--bone-soft); font-family: var(--font-m); font-size: 10px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--bone-dimmer); }

/* ==== MOBILE ==== */
@media (max-width: 900px) {
  .sources { grid-template-columns: 1fr; }
  .source-cell { border-right: none; border-bottom: 0.5px solid var(--ink-soft); padding: 26px 0; }
  .source-cell:last-child { border-bottom: none; }
  .source-cell:not(:first-child) { padding-left: 0; padding-top: 26px; }
  .compare { grid-template-columns: 1fr; }
  .compare-col { border-right: none; border-bottom: 1px solid var(--ink); padding: 26px 0; }
  .compare-col:last-child { border-bottom: none; padding-left: 0; padding-top: 26px; }
  .footer-cols { grid-template-columns: 1fr 1fr; }
  .footer-col-colophon { grid-column: 1 / -1; }
}

@media (max-width: 720px) {
  html, body { -webkit-text-size-adjust: 100%; }
  .container { padding: 0 20px; }
  .nav-top { padding: 14px 0 12px; align-items: center; gap: 14px; }
  .nav-top .nav-links { display: none; }
  .nav-brand .logo { font-size: 14px; }
  .nav-brand .logo-sub { font-size: 8.5px; letter-spacing: 0.22em; }
  .nav-cta { font-size: 10px; letter-spacing: 0.14em; }
  .nav-sticky-inner { padding: 10px 20px; gap: 14px; }
  .nav-sticky-brand { font-size: 13px; gap: 8px; }
  .nav-sticky-mark { width: 22px; height: 22px; }
  .nav-sticky-links { display: none; }
  .nav-sticky-cta { font-size: 10px; letter-spacing: 0.14em; }

  .page-head { padding: 32px 0 40px; }
  .doc-rail { flex-direction: column; align-items: flex-start; gap: 6px; font-size: 9.5px; letter-spacing: 0.2em; margin-bottom: 20px; padding-bottom: 12px; }
  .page-title { font-size: clamp(48px, 15vw, 96px); margin: 4px 0 22px; }
  .page-dek { font-size: 15.5px; }

  .content-section { padding: 44px 0; }
  .section-marker { font-size: 10px; margin-bottom: 16px; }
  .content-h { font-size: clamp(28px, 8vw, 50px); margin-bottom: 22px; }
  .content-body { font-size: 15.5px; line-height: 1.6; }
  .content-body p + p { margin-top: 16px; }

  .source-num { font-size: 9.5px; margin-bottom: 12px; }
  .source-h { font-size: 20px; margin-bottom: 14px; }
  .source-body { font-size: 13.5px; margin-bottom: 18px; }
  .source-detail { font-size: 9.5px; padding-top: 14px; }

  .numbered-list li { grid-template-columns: 40px 1fr; gap: 14px; padding: 22px 0; }
  .num-item-num { font-size: 11px; }
  .num-item-h { font-size: 18px; margin-bottom: 8px; }
  .num-item-body { font-size: 14.5px; line-height: 1.55; }
  .num-item-when { grid-column: 2; font-size: 9.5px; padding-top: 8px; }

  .dark-block { padding: 40px 24px; margin: 32px 0; }
  .dark-block-label { font-size: 10px; margin-bottom: 18px; }
  .dark-block-body { font-size: clamp(22px, 6vw, 34px); line-height: 1.15; }

  .compare-label { font-size: 10px; margin-bottom: 10px; }
  .compare-h { font-size: 20px; margin-bottom: 16px; }
  .compare-list li { font-size: 13.5px; padding: 10px 0; }

  .refuse-list li { grid-template-columns: 22px 1fr; gap: 12px; padding: 16px 0; }
  .refuse-mark { font-size: 13px; }
  .refuse-body { font-size: 14.5px; }

  .version-notes li { grid-template-columns: 72px 1fr; gap: 14px; padding: 14px 0; }
  .version-num { font-size: 10.5px; }
  .version-body { font-size: 13.5px; }
  .version-body-date { font-size: 9px; }

  .page-close { padding: 56px 0 40px; margin-top: 40px; }
  .close-h { font-size: clamp(36px, 11vw, 72px); margin-bottom: 22px; }
  .close-body { font-size: 15.5px; margin-bottom: 28px; }
  .cta-button { padding: 16px 28px; font-size: 12px; letter-spacing: 0.16em; }

  .footer { padding: 52px 0 40px; }
  .footer-signature { font-size: 10px; margin-bottom: 40px; padding-bottom: 22px; }
  .footer-cols { grid-template-columns: 1fr 1fr; gap: 28px; }
  .footer-col-colophon { grid-column: 1 / -1; }
  .footer-col-head { font-size: 9.5px; margin-bottom: 10px; }
  .footer-col a, .footer-col span { font-size: 12.5px; }
  .footer-copy { font-size: 9.5px; padding-top: 18px; }
}

@media (max-width: 480px) {
  .container { padding: 0 16px; }
  .page-title { font-size: clamp(42px, 16vw, 80px); }
  .footer-cols { grid-template-columns: 1fr; gap: 24px; }
}
a, button, [role="button"], .cta, .cta-primary, .cta-ghost, .nav-link, [href], [onclick] { cursor: pointer; }
