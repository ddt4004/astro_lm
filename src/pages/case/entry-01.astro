<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Case · Entry 01 · How it moved · LinksMaxing</title>
<meta name="description" content="Local service business. 60% to 100% AI mention rate. Position 12 to 5 in search. Four weeks, one spec, both surfaces. Three sources agreed.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&family=Saira+Condensed:wght@500;700;900&display=swap" rel="stylesheet">
<style>
/* ==== DESIGN TOKENS ==== */
:root {
  --bone: #F4F1EA;
  --ink:  #151412;
  --ox:   #6E0E0E;
  --ox-hover: #8B1616;
  --ink-dim:    rgba(21, 20, 18, 0.72);
  --ink-dimmer: rgba(21, 20, 18, 0.5);
  --ink-rule:   rgba(21, 20, 18, 0.22);
  --ink-soft:   rgba(21, 20, 18, 0.14);
  --bone-dim:    rgba(244, 241, 234, 0.72);
  --bone-dimmer: rgba(244, 241, 234, 0.5);
  --bone-rule:   rgba(244, 241, 234, 0.22);
  --bone-soft:   rgba(244, 241, 234, 0.14);
  --font-d: 'Saira Condensed', Impact, sans-serif;
  --font-b: 'Inter', system-ui, sans-serif;
  --font-m: 'JetBrains Mono', ui-monospace, monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
body {
  background: var(--bone);
  color: var(--ink);
  font-family: var(--font-b);
  font-size: 16px;
  line-height: 1.5;
  overflow-x: hidden;
}
a { color: inherit; text-decoration: none; }
::selection { background: var(--ox); color: var(--bone); }

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 clamp(20px, 4vw, 64px);
}
.section {
  padding: clamp(80px, 12vh, 150px) 0;
}
.section-dark { background: var(--ink); color: var(--bone); }

/* ==== TOP NAV ==== */
.nav-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20px 0 16px;
  border-bottom: 0.5px solid var(--ink-soft);
  gap: 24px;
}

/* Main nav logo mark */
.nav-mark {
  display: block;
  width: 22px;
  height: 22px;
  color: var(--ink);
  flex-shrink: 0;
  align-self: center;
}

.nav-brand { display: inline-flex; align-items: baseline; gap: 10px; }
.nav-brand .logo { font-weight: 500; font-size: 15px; letter-spacing: -0.005em; line-height: 1; }
.nav-brand .logo-sub {
  font-family: var(--font-m);
  font-size: 9px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
  line-height: 1;
}
.nav-links { display: flex; gap: clamp(18px, 2.2vw, 28px); align-items: baseline; }
.nav-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-dim);
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--ink); }
.nav-links a.active { color: var(--ox); }
.nav-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
  white-space: nowrap;
}

/* ==== STICKY NAV ==== */
.nav-sticky {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(244, 241, 234, 0.94);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border-bottom: 0.5px solid var(--ink-rule);
  transform: translateY(-105%);
  transition: transform 380ms cubic-bezier(0.2, 0.7, 0.2, 1);
  pointer-events: none;
}
.nav-sticky.visible { transform: translateY(0); pointer-events: auto; }
.nav-sticky-inner {
  max-width: 1280px; margin: 0 auto;
  padding: 12px clamp(20px, 4vw, 64px);
  display: flex; justify-content: space-between; align-items: center; gap: 24px;
}
.nav-sticky-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; font-size: 14px; color: var(--ink); white-space: nowrap; }
.nav-sticky-mark { display: block; width: 26px; height: 26px; color: var(--ink); }
.nav-sticky-links { display: flex; gap: clamp(16px, 2vw, 26px); }
.nav-sticky-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-dim);
}
.nav-sticky-links a.active { color: var(--ox); }
.nav-sticky-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
}

/* ==== PAGE HEADER — case-specific treatment ==== */
.page-head {
  padding: clamp(40px, 6vh, 72px) 0 clamp(56px, 9vh, 96px);
  border-bottom: 0.5px solid var(--ink-rule);
}
.case-label {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 24px;
  display: flex;
  align-items: baseline;
  gap: 14px;
}
.case-label-dim { color: var(--ink-dim); }
.case-title {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(52px, 8.5vw, 132px);
  line-height: 0.88;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  margin-bottom: 28px;
  text-wrap: balance;
}
.case-title .ox { color: var(--ox); }
.case-dek {
  font-size: clamp(17px, 1.35vw, 20px);
  line-height: 1.6;
  color: var(--ink-dim);
  max-width: 780px;
  margin-bottom: clamp(40px, 6vh, 60px);
}
.case-meta {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(20px, 3vw, 40px);
  padding: 24px 0;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
}
.case-meta-cell { display: flex; flex-direction: column; gap: 6px; }
.case-meta-label {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
}
.case-meta-value {
  font-family: var(--font-b);
  font-size: 14.5px;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.3;
}

/* ==== CONTENT SECTIONS ==== */
.content-section {
  padding: clamp(64px, 10vh, 120px) 0;
  border-top: 0.5px solid var(--ink-soft);
}
.content-section:first-of-type { border-top: none; }
.section-marker {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 22px;
}
.content-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(36px, 5.5vw, 78px);
  line-height: 0.94;
  letter-spacing: -0.025em;
  text-transform: uppercase;
  margin-bottom: 32px;
  text-wrap: balance;
}
.content-h .ox { color: var(--ox); }
.content-body {
  max-width: 820px;
  font-size: 17px;
  line-height: 1.65;
  color: var(--ink-dim);
}
.content-body p + p { margin-top: 20px; }
.content-body strong { color: var(--ink); font-weight: 500; }
.content-body em { color: var(--ox); font-style: normal; font-weight: 500; }

/* ==== BASELINE vs. AFTER STAT COMPARISON ==== */
.stat-compare {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(32px, 5vw, 72px);
  margin: 44px 0 0;
  padding: 32px 0;
  border-top: 3px solid var(--ink);
  border-bottom: 3px solid var(--ink);
}
.stat-compare-cell { display: flex; flex-direction: column; }
.stat-compare-label {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
  margin-bottom: 14px;
}
.stat-compare-value {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(44px, 5.5vw, 88px);
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--ink);
  display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap;
  margin-bottom: 18px;
}
.stat-compare-value .before { color: var(--ink-dimmer); }
.stat-compare-value .arrow { color: var(--ink-dim); font-size: 0.6em; }
.stat-compare-value .after { color: var(--ox); }
.stat-compare-gain {
  padding-top: 16px;
  border-top: 1px solid var(--ink-rule);
}
.stat-compare-delta {
  display: block;
  font-family: var(--font-m);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 6px;
}
.stat-compare-note {
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--ink-dim);
}

/* ==== THREE-SOURCE FINDING GRID ==== */
.finding-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-top: 40px;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
}
.finding-cell {
  padding: 32px clamp(16px, 2vw, 28px) 32px 0;
  border-right: 0.5px solid var(--ink-soft);
}
.finding-cell:last-child { border-right: none; padding-right: 0; }
.finding-cell:not(:first-child) { padding-left: clamp(16px, 2vw, 28px); }
.finding-num {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 16px;
}
.finding-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: 22px;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 14px;
}
.finding-body {
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink-dim);
  margin-bottom: 16px;
}
.finding-tag {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  padding-top: 14px;
  border-top: 0.5px solid var(--ink-soft);
  display: block;
}

/* ==== SHIP LIST — what got built ==== */
.ship-list {
  list-style: none;
  padding: 0;
  margin: 32px 0 0;
  border-top: 1px solid var(--ink);
}
.ship-list li {
  display: grid;
  grid-template-columns: 34px 1fr 100px;
  gap: clamp(16px, 3vw, 32px);
  padding: 20px 0;
  border-bottom: 0.5px solid var(--ink-soft);
  align-items: baseline;
}
.ship-num {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.2em;
  color: var(--ink-dimmer);
}
.ship-body {
  font-size: 15.5px;
  line-height: 1.55;
  color: var(--ink);
}
.ship-body em { color: var(--ox); font-style: normal; font-weight: 500; }
.ship-source {
  font-family: var(--font-m);
  font-size: 9.5px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ox);
  text-align: right;
}

/* ==== DARK PULL-QUOTE BLOCK ==== */
.dark-block {
  background: var(--ink);
  color: var(--bone);
  padding: clamp(44px, 7vh, 88px) clamp(24px, 4vw, 64px);
  margin: clamp(48px, 7vh, 88px) 0;
}
.dark-block-label {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: 24px;
}
.dark-block-body {
  font-family: var(--font-d);
  font-weight: 700;
  font-size: clamp(28px, 3.6vw, 52px);
  line-height: 1.1;
  letter-spacing: -0.015em;
  color: var(--bone);
  max-width: 940px;
}
.dark-block-body em { color: var(--ox); font-style: normal; font-weight: 900; }

/* ==== TIMELINE ==== */
.timeline {
  margin: 40px 0 0;
  border-left: 3px solid var(--ink);
  padding-left: 28px;
}
.timeline-item { padding-bottom: 34px; position: relative; }
.timeline-item:last-child { padding-bottom: 0; }
.timeline-item::before {
  content: "";
  position: absolute;
  left: -37px;
  top: 6px;
  width: 12px;
  height: 12px;
  background: var(--ox);
  border-radius: 50%;
}
.timeline-date {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 8px;
}
.timeline-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: 22px;
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 8px;
}
.timeline-body { font-size: 15px; line-height: 1.55; color: var(--ink-dim); max-width: 640px; }

/* ==== REFUSE / DIDN'T TOUCH LIST ==== */
.refuse-list {
  margin: 32px 0 0;
  padding: 0;
  list-style: none;
}
.refuse-list li {
  padding: 18px 0;
  border-top: 0.5px solid var(--ink-soft);
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24px;
  align-items: baseline;
}
.refuse-list li:last-child { border-bottom: 0.5px solid var(--ink-soft); }
.refuse-what { font-size: 15.5px; color: var(--ink); }
.refuse-why {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
  white-space: nowrap;
}

/* ==== PAGE CLOSE ==== */
.page-close {
  padding: clamp(80px, 12vh, 140px) 0 clamp(48px, 8vh, 96px);
  margin-top: clamp(56px, 8vh, 96px);
  border-top: 3px solid var(--ink);
}
.close-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(44px, 8vw, 110px);
  line-height: 0.92;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  margin-bottom: 28px;
  text-wrap: balance;
}
.close-h .ox { color: var(--ox); }
.close-body {
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink-dim);
  max-width: 640px;
  margin-bottom: 36px;
}
.cta-button {
  display: inline-block;
  background: var(--ox);
  color: var(--bone);
  font-family: var(--font-m);
  font-weight: 500;
  font-size: 13px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 20px 36px;
  transition: background 0.2s;
}
.cta-button:hover { background: var(--ox-hover); }
.close-alt {
  margin-top: 26px;
  font-size: 14px;
  color: var(--ink-dim);
}
.close-alt a { color: var(--ink); border-bottom: 1px solid var(--ink-rule); padding-bottom: 1px; }

/* ==== FOOTER ==== */
.footer { padding: clamp(60px, 8vh, 100px) 0 clamp(36px, 5vh, 60px); }
.footer-mark { width: 32px; height: 32px; color: var(--bone); margin-bottom: 18px; }
.footer-signature {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: clamp(48px, 6vh, 72px);
  padding-bottom: 28px;
  border-bottom: 0.5px solid var(--bone-rule);
}
.footer-cols {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: clamp(28px, 4vw, 64px);
  margin-bottom: 40px;
}
.footer-col-head {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: 14px;
}
.footer-col a, .footer-col span, .footer-col p {
  display: block;
  font-size: 13.5px;
  line-height: 1.75;
  color: var(--bone-dim);
  transition: color 0.2s;
}
.footer-col a:hover { color: var(--bone); }
.footer-col-colophon p { font-size: 12.5px; line-height: 1.75; color: var(--bone-dimmer); max-width: 380px; }
.footer-col-colophon p em { color: var(--ox); font-style: normal; }
.footer-copy {
  padding-top: 22px;
  border-top: 0.5px solid var(--bone-soft);
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--bone-dimmer);
}

/* ==== MOBILE ==== */
@media (max-width: 900px) {
  .case-meta { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .finding-grid { grid-template-columns: 1fr; }
  .finding-cell { border-right: none; border-bottom: 0.5px solid var(--ink-soft); padding: 24px 0; }
  .finding-cell:last-child { border-bottom: none; }
  .finding-cell:not(:first-child) { padding-left: 0; }
  .stat-compare { grid-template-columns: 1fr; gap: 32px; }
  .footer-cols { grid-template-columns: 1fr 1fr; }
  .footer-col-colophon { grid-column: 1 / -1; }
}

@media (max-width: 720px) {
  html, body { -webkit-text-size-adjust: 100%; }
  .container { padding: 0 20px; }

  .nav-top { padding: 14px 0 12px; align-items: center; gap: 14px; }
  .nav-top .nav-links { display: none; }
  .nav-brand .logo { font-size: 14px; }
  .nav-brand .logo-sub { font-size: 8.5px; letter-spacing: 0.22em; }
  .nav-cta { font-size: 10px; letter-spacing: 0.14em; }
  .nav-sticky-inner { padding: 10px 20px; gap: 14px; }
  .nav-sticky-brand { font-size: 13px; gap: 8px; }
  .nav-sticky-mark { width: 22px; height: 22px; }
  .nav-sticky-links { display: none; }
  .nav-sticky-cta { font-size: 10px; letter-spacing: 0.14em; }

  .page-head { padding: 32px 0 40px; }
  .case-label { font-size: 10px; margin-bottom: 18px; flex-wrap: wrap; gap: 8px; }
  .case-title { font-size: clamp(38px, 12vw, 78px); margin-bottom: 22px; }
  .case-dek { font-size: 15.5px; margin-bottom: 32px; }
  .case-meta-label { font-size: 9px; letter-spacing: 0.18em; }
  .case-meta-value { font-size: 13.5px; }

  .content-section { padding: 48px 0; }
  .section-marker { font-size: 10px; margin-bottom: 16px; }
  .content-h { font-size: clamp(28px, 8.5vw, 50px); margin-bottom: 22px; }
  .content-body { font-size: 15.5px; line-height: 1.6; }

  .stat-compare { margin-top: 32px; padding: 24px 0; }
  .stat-compare-label { font-size: 10px; margin-bottom: 10px; }
  .stat-compare-value { font-size: clamp(34px, 10vw, 60px); gap: 12px; margin-bottom: 14px; }
  .stat-compare-gain { padding-top: 12px; }
  .stat-compare-delta { font-size: 11px; letter-spacing: 0.12em; }
  .stat-compare-note { font-size: 13px; }

  .finding-num { font-size: 9.5px; margin-bottom: 12px; }
  .finding-h { font-size: 19px; margin-bottom: 10px; }
  .finding-body { font-size: 13.5px; }
  .finding-tag { font-size: 9.5px; padding-top: 12px; }

  .ship-list li { grid-template-columns: 28px 1fr; gap: 14px; padding: 18px 0; }
  .ship-source { grid-column: 2; text-align: left; padding-top: 4px; font-size: 9.5px; }
  .ship-num { font-size: 10px; }
  .ship-body { font-size: 14.5px; }

  .dark-block { padding: 36px 24px; margin: 32px 0; }
  .dark-block-label { font-size: 10px; margin-bottom: 18px; }
  .dark-block-body { font-size: clamp(22px, 6vw, 34px); line-height: 1.15; }

  .timeline { padding-left: 20px; border-left-width: 2px; }
  .timeline-item::before { left: -27px; width: 10px; height: 10px; }
  .timeline-item { padding-bottom: 26px; }
  .timeline-date { font-size: 9.5px; margin-bottom: 6px; }
  .timeline-h { font-size: 18px; }
  .timeline-body { font-size: 14px; }

  .refuse-list li { grid-template-columns: 1fr; gap: 6px; padding: 14px 0; }
  .refuse-what { font-size: 14.5px; }
  .refuse-why { font-size: 9.5px; white-space: normal; }

  .page-close { padding: 56px 0 40px; margin-top: 40px; }
  .close-h { font-size: clamp(36px, 11vw, 72px); margin-bottom: 22px; }
  .close-body { font-size: 15.5px; margin-bottom: 28px; }
  .cta-button { padding: 16px 28px; font-size: 12px; letter-spacing: 0.16em; }

  .footer { padding: 52px 0 40px; }
