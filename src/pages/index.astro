<script is:inline>
/* ------------------------------------------------------------------
   Sticky nav — reveals when the masthead scrolls out of view
   ------------------------------------------------------------------ */
(function(){
  var stickyNav = document.querySelector('.nav-sticky');
  var trigger = document.querySelector('.masthead');
  if (!stickyNav || !trigger || !('IntersectionObserver' in window)) return;
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      var show = !e.isIntersecting;
      stickyNav.classList.toggle('visible', show);
      stickyNav.setAttribute('aria-hidden', show ? 'false' : 'true');
    });
  }, { rootMargin: '-40px 0px 0px 0px', threshold: 0 });
  obs.observe(trigger);
})();

/* ------------------------------------------------------------------
   Reveal on scroll — motion class gates all animations
   ------------------------------------------------------------------ */
(function(){
  if (!document.documentElement.classList.contains('motion')) return;

  var revealObs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) {
        e.target.classList.add('in-view');
        revealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
  document.querySelectorAll('.reveal').forEach(function(el){ revealObs.observe(el); });

  /* Index table row cascade */
  var idxObs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) {
        e.target.querySelectorAll('.idx-row').forEach(function(row, i){
          setTimeout(function(){ row.classList.add('in-view'); }, i * 40);
        });
        idxObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  var table = document.getElementById('index-table');
  if (table) idxObs.observe(table);
})();
</script>
