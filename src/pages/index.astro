<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LinksMaxing · AI visibility, measured. Real data. Real decisions.</title>
<meta name="description" content="Three sources, cross-referenced. AI answers, search performance, site structure. We measure whether AI names your business and hand you a build spec your team can ship against.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&family=Saira+Condensed:wght@500;700;900&display=swap" rel="stylesheet">
<style>
/* =========================================================
   DESIGN TOKENS — three colors, three faces, no substitutions
   ========================================================= */
:root {
  --bone: #F4F1EA;
  --ink:  #151412;
  --ox:   #6E0E0E;
  --ox-hover: #8B1616;

  --ink-dim:     rgba(21, 20, 18, 0.72);
  --ink-dimmer:  rgba(21, 20, 18, 0.5);
  --ink-rule:    rgba(21, 20, 18, 0.22);
  --ink-soft:    rgba(21, 20, 18, 0.14);

  --bone-dim:    rgba(244, 241, 234, 0.72);
  --bone-dimmer: rgba(244, 241, 234, 0.5);
  --bone-rule:   rgba(244, 241, 234, 0.22);
  --bone-soft:   rgba(244, 241, 234, 0.14);

  --font-d: 'Saira Condensed', Impact, sans-serif;
  --font-b: 'Inter', system-ui, sans-serif;
  --font-m: 'JetBrains Mono', ui-monospace, monospace;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
body {
  background: var(--bone);
  color: var(--ink);
  font-family: var(--font-b);
  font-size: 16px;
  line-height: 1.5;
  overflow-x: hidden;
}
a { color: inherit; text-decoration: none; }
::selection { background: var(--ox); color: var(--bone); }

/* =========================================================
   CONTAINER + SECTION SHELLS
   ========================================================= */
.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 clamp(20px, 4vw, 64px);
}
.section {
  padding: clamp(80px, 12vh, 150px) 0;
  position: relative;
}
.section-dark {
  background: var(--ink);
  color: var(--bone);
}
.section-ox {
  background: var(--ox);
  color: var(--bone);
}
.section-tight {
  padding: clamp(60px, 8vh, 100px) 0;
}

/* =========================================================
   COMMON TYPOGRAPHY UTILITIES
   ========================================================= */
.label {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-dim);
}
.section-dark .label, .section-ox .label { color: var(--bone-dim); }

.link-arrow {
  display: inline-block;
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink);
  border-bottom: 1px solid var(--ink);
  padding-bottom: 3px;
  transition: opacity 0.2s;
}
.link-arrow:hover { opacity: 0.65; }
.section-dark .link-arrow { color: var(--bone); border-bottom-color: var(--bone); }
.section-ox .link-arrow { color: var(--bone); border-bottom-color: var(--bone); }

.ox-word { color: var(--ox); font-weight: 900; }
.section-dark .ox-word { color: var(--ox); }
.section-ox .ox-word { color: var(--bone); font-weight: 900; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }

/* =========================================================
   TOP NAV
   ========================================================= */
.nav-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20px 0 16px;
  border-bottom: 0.5px solid var(--ink-soft);
  gap: 24px;
}

/* Main nav logo mark */
.nav-mark {
  display: block;
  width: 22px;
  height: 22px;
  color: var(--ink);
  flex-shrink: 0;
  align-self: center;
}

.nav-brand { display: inline-flex; align-items: baseline; gap: 10px; }
.nav-brand .logo { font-weight: 500; font-size: 15px; letter-spacing: -0.005em; line-height: 1; }
.nav-brand .logo-sub {
  font-family: var(--font-m);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-dimmer);
  line-height: 1;
}
.nav-links {
  display: flex;
  gap: clamp(18px, 2.2vw, 28px);
  align-items: baseline;
}
.nav-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-dim);
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--ink); }
.nav-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
  white-space: nowrap;
  transition: color 0.2s, border-color 0.2s;
}
.nav-cta:hover { color: var(--ox-hover); border-color: var(--ox-hover); }

/* =========================================================
   STICKY NAV — appears when masthead scrolls out
   ========================================================= */
.nav-sticky {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(244, 241, 234, 0.94);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border-bottom: 0.5px solid var(--ink-rule);
  transform: translateY(-105%);
  transition: transform 380ms cubic-bezier(0.2, 0.7, 0.2, 1);
  pointer-events: none;
}
.nav-sticky.visible { transform: translateY(0); pointer-events: auto; }
.nav-sticky-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 12px clamp(20px, 4vw, 64px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
}
.nav-sticky-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 500;
  font-size: 14px;
  letter-spacing: -0.005em;
  color: var(--ink);
  white-space: nowrap;
}
.nav-sticky-mark {
  display: block;
  width: 26px;
  height: 26px;
  object-fit: contain;
  flex-shrink: 0;
}
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }

.nav-sticky-links {
  display: flex;
  gap: clamp(16px, 2vw, 26px);
}
.nav-sticky-links a {
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-dim);
  transition: color 0.2s;
}
.nav-sticky-links a:hover { color: var(--ink); }
.nav-sticky-cta {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ox);
  border-bottom: 1px solid var(--ox);
  padding-bottom: 3px;
  white-space: nowrap;
}

/* =========================================================
   MASTHEAD — LINKSMAXING wordmark
   ========================================================= */
.masthead {
  padding: clamp(28px, 5vh, 60px) 0 clamp(24px, 4vh, 40px);
}
.masthead-word {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(64px, 15.5vw, 220px);
  line-height: 0.82;
  letter-spacing: -0.045em;
  text-transform: uppercase;
  color: var(--ox);
  display: block;
  white-space: nowrap;
  padding: 4px 0; user-select: none; pointer-events: none;
}
.masthead-rule {
  height: 6px;
  background: var(--ink);
  margin: 6px 0 16px;
}
.masthead-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20px;
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink);
}
.masthead-loc { line-height: 1.4; }
.masthead-nav {
  display: flex;
  gap: clamp(14px, 2vw, 26px);
}
.masthead-nav a { color: var(--ink-dim); transition: color 0.2s; }
.masthead-nav a:hover { color: var(--ox); }

/* =========================================================
   ACT 01 — HERO SPECIMEN (dark bg)
   Real broken production markup with embedded oxblood
   equation reveal reading top to bottom.
   ========================================================= */
.hero-specimen { padding-top: clamp(72px, 10vh, 120px); }
.spec-label {
  margin-bottom: 22px;
}
.spec-live {
  color: var(--ox);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-left: 4px;
}
.spec-live-dot {
  display: inline-block;
  width: 6px; height: 6px;
  background: var(--ox);
  border-radius: 50%;
  animation: pulse 1.6s ease-in-out infinite;
  vertical-align: 1px;
}
.spec-slab {
  border-left: 5px solid var(--ox);
  padding: 22px 0 24px 28px;
  overflow-x: auto;
  margin-top: 6px;
}
.spec-code {
  display: grid;
  grid-template-columns: max-content max-content;
  gap: 0 40px;
  font-family: var(--font-m);
  font-weight: 500;
  font-size: clamp(12px, 1.15vw, 16px);
  line-height: 1.65;
  color: var(--bone-dim);
  white-space: pre;
}
.spec-code .cmt { color: var(--bone-dimmer); }
.spec-code .key {
  color: var(--ox);
  font-weight: 700;
  font-size: 1.15em;
  letter-spacing: 0.01em;
}
.spec-resolve {
  margin-top: 26px;
  padding: 18px 0 18px 28px;
  border-left: 5px solid var(--ox);
  display: flex;
  align-items: baseline;
  gap: 14px;
  font-family: var(--font-m);
  font-weight: 700;
  font-size: clamp(14px, 1.4vw, 20px);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--bone);
}
.spec-resolve .sym { color: var(--ox); font-size: 1.3em; line-height: 1; }
.spec-resolve .stmt {
  border-bottom: 2px solid var(--ox);
  padding-bottom: 3px;
}
.spec-actions {
  display: flex;
  align-items: center;
  gap: clamp(24px, 4vw, 44px);
  flex-wrap: wrap;
  margin-top: 44px;
}
.cta-primary {
  display: inline-block;
  background: var(--ox);
  color: var(--bone);
  font-family: var(--font-m);
  font-weight: 500;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 18px 32px;
  transition: background 0.2s;
}
.cta-primary:hover { background: var(--ox-hover); }
.spec-caption {
  font-size: 14px;
  line-height: 1.5;
  color: var(--bone-dim);
  max-width: 500px;
}

/* =========================================================
   ACT 02 — THE AI VISIBILITY INDEX (dark bg)
   ========================================================= */
.index-section { padding-top: clamp(72px, 10vh, 120px); }
.index-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20px;
  font-family: var(--font-m);
  font-size: 10.5px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--bone-dim);
  padding-bottom: 12px;
  border-bottom: 0.5px solid var(--bone-rule);
}
.index-headline {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(48px, 10vw, 148px);
  line-height: 0.86;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  padding: 22px 0 12px;
  color: var(--bone);
}
.index-subhead {
  font-family: var(--font-m);
  font-size: clamp(11px, 1vw, 14px);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--bone-dim);
  padding: 8px 0 0;
  border-top: 0.5px solid var(--bone-rule);
}

.index-table {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) 130px 100px 70px 90px;
  gap: 0 20px;
  margin-top: 40px;
  font-family: var(--font-m);
  font-size: 13.5px;
  align-items: baseline;
}
.index-thead-cell {
  padding-bottom: 12px;
  border-bottom: 1px solid var(--bone-rule);
  font-size: 9.5px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--bone-dimmer);
  font-weight: 500;
}
.index-cell {
  padding: 16px 0;
  border-bottom: 1px solid var(--bone-soft);
}
.index-cell-num { color: var(--bone-dimmer); }
.index-cell-query { font-weight: 500; color: var(--bone); }
.index-cell-cat {
  font-size: 10.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--bone-dim);
}
.index-cell-rate {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: 30px;
  line-height: 1;
  color: var(--ox);
  text-align: right;
}
.index-cell-delta { color: var(--bone-dim); text-align: right; }
.index-cell-last { color: var(--bone-dimmer); text-align: right; font-size: 11.5px; }
.index-thick { grid-column: 1 / -1; height: 3px; background: var(--bone); margin-top: 4px; }

.index-foot {
  margin-top: 40px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
}
.index-note {
  font-family: var(--font-b);
  font-size: 14.5px;
  line-height: 1.6;
  color: var(--bone-dim);
  max-width: 640px;
}

/* =========================================================
   ACT 03 — WE DO THE STRUCTURE (bone bg, 3 columns)
   ========================================================= */
.method-section { padding: clamp(96px, 15vh, 180px) 0; }
.method-head {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(52px, 9vw, 128px);
  line-height: 0.9;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  margin-bottom: 30px;
}
.method-body {
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink-dim);
  max-width: 780px;
  margin-bottom: clamp(56px, 8vh, 88px);
}
.method-cols {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(28px, 4vw, 56px);
}
.method-col {
  padding-top: 24px;
  border-top: 3px solid var(--ink);
}
.method-col-num {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 20px;
}
.method-col-h {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(24px, 2.6vw, 34px);
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin-bottom: 18px;
}
.method-col-body {
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink-dim);
  margin-bottom: 24px;
}
.method-col-tag {
  font-family: var(--font-m);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ox);
  padding-top: 18px;
  border-top: 1px solid var(--ink-soft);
}

/* =========================================================
   ACT 04 — AI AND SEO MOVE TOGETHER (bone, small callout)
   ========================================================= */
.correlation {
  padding: clamp(70px, 10vh, 130px) 0;
  border-top: 0.5px solid var(--ink-rule);
}
.correlation-head {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(44px, 7.5vw, 110px);
  line-height: 0.92;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  margin-bottom: 28px;
}
.correlation-body {
  font-size: 17px;
  line-height: 1.65;
  color: var(--ink-dim);
  max-width: 780px;
  margin-bottom: 32px;
}

/* =========================================================
   ACT 05 — THE MANIFESTO (oxblood bg — the emotional peak)
   Kruger wall. Saira Condensed body. Everything is LOUD.
   Light text only. Contrast is non-negotiable here.
   ========================================================= */

/* Manifesto redesign — pull-quote rhythm ─────────────── */
.manifesto-label-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-top: 4px solid var(--bone);
  border-bottom: 1px solid var(--bone);
  padding: 12px 0;
  margin-bottom: 64px;
  gap: 16px;
  flex-wrap: wrap;
}
.manifesto-meta {
  font-family: var(--font-m);
  font-size: 10px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  opacity: 0.65;
  color: var(--bone);
}
.manifesto-para {
  font-family: var(--font-b);
  font-size: clamp(20px, 1.6vw, 26px);
  line-height: 1.42;
  font-weight: 500;
  max-width: 820px;
  color: var(--bone);
}
.manifesto-para + .manifesto-para { margin-top: 24px; }
.manifesto-para .real { font-weight: 900; }
.manifesto-pull {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(72px, 10vw, 148px);
  line-height: 0.82;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  color: var(--bone);
  margin: 72px 0;
  max-width: 1200px;
}
.manifesto-pull-index {
  display: block;
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.32em;
  color: var(--bone);
  opacity: 0.55;
  margin-bottom: 20px;
}
.manifesto-close-block {
  margin-top: 96px;
  padding-top: 48px;
  border-top: 4px solid var(--ink);
}
@media (max-width: 720px) {
  .manifesto-para { font-size: 18px; line-height: 1.45; }
  .manifesto-pull { margin: 48px 0; font-size: clamp(52px, 14vw, 100px); }
  .manifesto-close-block { margin-top: 64px; padding-top: 32px; }
  .manifesto-label-row { flex-direction: column; align-items: flex-start; gap: 6px; }
}

/* ─────────────────────────────────────────────────────── */

.manifesto-section {
  padding: clamp(120px, 18vh, 200px) 0;
}
.manifesto-label {
  font-size: 12px;
  letter-spacing: 0.28em;
  color: var(--bone-dim);
  margin-bottom: clamp(44px, 6vh, 72px);
  padding-bottom: 18px;
  border-bottom: 1px solid var(--bone-rule);
}
.manifesto-body {
  font-family: var(--font-d);
  font-weight: 700;
  font-size: clamp(26px, 2.6vw, 44px);
  line-height: 1.14;
  letter-spacing: -0.005em;
  color: var(--bone);
  max-width: 1080px;
  margin-bottom: clamp(60px, 9vh, 100px);
  text-wrap: pretty;
}
.manifesto-body .real {
  font-weight: 900;
}
.manifesto-close {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(60px, 11vw, 200px);
  line-height: 0.88;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  color: var(--ink);
  text-wrap: balance;
  margin-bottom: clamp(40px, 6vh, 68px);
}
.manifesto-link {
  color: var(--bone);
  border-bottom-color: var(--bone);
  font-size: 12px;
  letter-spacing: 0.2em;
}

/* =========================================================
   ACT 06 — PROOF (dark bg, giant #1)
   ========================================================= */
.proof-section {
  padding: clamp(90px, 14vh, 170px) 0;
}
.proof-label {
  color: var(--bone-dim);
  margin-bottom: 30px;
}
.proof-number {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(200px, 30vw, 460px);
  line-height: 0.82;
  letter-spacing: -0.06em;
  color: var(--ox);
  margin-bottom: 4px;
}
.proof-scope {
  font-family: var(--font-m);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: clamp(56px, 8vh, 88px);
}
.proof-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(32px, 5vw, 72px);
  padding: 32px 0;
  border-top: 1px solid var(--bone-rule);
  border-bottom: 1px solid var(--bone-rule);
  margin-bottom: clamp(48px, 6vh, 72px);
}
.proof-stat-label {
  font-family: var(--font-m);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--bone-dim);
  margin-bottom: 12px;
}
.proof-stat-value {
  font-family: var(--font-d);
  font-weight: 900;
  font-size: clamp(36px, 4.5vw, 72px);
  line-height: 1;
  letter-spacing: -0.025em;
  color: var(--bone);
  display: flex;
  align-items: baseline;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}
.stat-before { color: var(--bone-dimmer); }
.stat-arrow { color: var(--bone-dim); font-size: 0.7em; }
.stat-after { color: var(--ox); }

.proof-stat-gain {
  padding-top: 16px;
  border-top: 1px solid var(--bone-rule);
}
.proof-stat-delta {
  display: block;
  font-family: var(--font-m);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ox);
  margin-bottom: 6px;
}
.proof-stat-note {
  display: block;
  font-family: var(--font-b);
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--bone-dim);
}

.proof-meta {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
